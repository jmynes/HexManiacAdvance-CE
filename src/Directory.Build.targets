<Project>
  <!--
    Stages a self-contained CPython "embeddable package" next to a project's build output
    for the pythonnet-based scripting engine (PythonTool). pythonnet needs a real CPython
    DLL at runtime; it doesn't bundle one. Downloads once into a shared, gitignored cache
    under artifacts/, then copies from that cache into $(TargetDir)resources\python\<arch>\
    on every build, so a clean checkout just works with `dotnet build` (first build needs
    network access to fetch the embeddable package; later builds use the cache).

    A project opts in by setting <BundlePythonRuntimeX64>true</BundlePythonRuntimeX64> and/or
    <BundlePythonRuntimeX86>true</BundlePythonRuntimeX86> in its own .csproj.
  -->
  <PropertyGroup>
    <PythonRuntimeVersion>3.12.8</PythonRuntimeVersion>
    <PythonRuntimeCacheDir>$(SolutionDir)artifacts\PythonRuntime\$(PythonRuntimeVersion)\</PythonRuntimeCacheDir>
    <!-- e.g. "3.12.8" -> "312", to name the version-specific python3xx.dll / python3xx._pth -->
    <PythonRuntimeMajorMinor>$(PythonRuntimeVersion.Split('.')[0])$(PythonRuntimeVersion.Split('.')[1])</PythonRuntimeMajorMinor>
  </PropertyGroup>

  <!-- Packages installed into the bundled runtime's site-packages, for use by user-written
       HMA python scripts (e.g. `import requests`). The embeddable package ships with
       site-packages/pip disabled by design; opting a package in here bootstraps pip once
       and installs it, so it's available out of the box rather than needing a manual,
       per-machine, per-clean-build fix. A failure here (e.g. no network) only warns -
       it must never block building the editor itself. -->
  <ItemGroup>
    <PythonRuntimePackage Include="requests" />
    <PythonRuntimePackage Include="numpy" />
    <PythonRuntimePackage Include="pandas" />
    <PythonRuntimePackage Include="matplotlib" />
  </ItemGroup>

  <Target Name="StagePythonRuntimeX64" AfterTargets="Build" Condition="'$(BundlePythonRuntimeX64)' == 'true'">
    <DownloadFile
      Condition="!Exists('$(PythonRuntimeCacheDir)x64\.complete')"
      SourceUrl="https://www.python.org/ftp/python/$(PythonRuntimeVersion)/python-$(PythonRuntimeVersion)-embed-amd64.zip"
      DestinationFolder="$(PythonRuntimeCacheDir)"
      DestinationFileName="python-embed-amd64.zip" />
    <Unzip
      Condition="!Exists('$(PythonRuntimeCacheDir)x64\.complete')"
      SourceFiles="$(PythonRuntimeCacheDir)python-embed-amd64.zip"
      DestinationFolder="$(PythonRuntimeCacheDir)x64\" />
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="_EnablePythonRuntimeSitePackages"
             Properties="PythonRuntimeArchDir=$(PythonRuntimeCacheDir)x64\"
             Condition="!Exists('$(PythonRuntimeCacheDir)x64\.complete')" />
    <Touch
      Condition="!Exists('$(PythonRuntimeCacheDir)x64\.complete')"
      Files="$(PythonRuntimeCacheDir)x64\.complete"
      AlwaysCreate="true" />
    <ItemGroup>
      <_PythonRuntimeFilesX64 Include="$(PythonRuntimeCacheDir)x64\**\*" Exclude="$(PythonRuntimeCacheDir)x64\.complete" />
    </ItemGroup>
    <Copy SourceFiles="@(_PythonRuntimeFilesX64)" DestinationFolder="$(TargetDir)resources\python\x64\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StagePythonRuntimeX86" AfterTargets="Build" Condition="'$(BundlePythonRuntimeX86)' == 'true'">
    <DownloadFile
      Condition="!Exists('$(PythonRuntimeCacheDir)x86\.complete')"
      SourceUrl="https://www.python.org/ftp/python/$(PythonRuntimeVersion)/python-$(PythonRuntimeVersion)-embed-win32.zip"
      DestinationFolder="$(PythonRuntimeCacheDir)"
      DestinationFileName="python-embed-win32.zip" />
    <Unzip
      Condition="!Exists('$(PythonRuntimeCacheDir)x86\.complete')"
      SourceFiles="$(PythonRuntimeCacheDir)python-embed-win32.zip"
      DestinationFolder="$(PythonRuntimeCacheDir)x86\" />
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="_EnablePythonRuntimeSitePackages"
             Properties="PythonRuntimeArchDir=$(PythonRuntimeCacheDir)x86\"
             Condition="!Exists('$(PythonRuntimeCacheDir)x86\.complete')" />
    <Touch
      Condition="!Exists('$(PythonRuntimeCacheDir)x86\.complete')"
      Files="$(PythonRuntimeCacheDir)x86\.complete"
      AlwaysCreate="true" />
    <ItemGroup>
      <_PythonRuntimeFilesX86 Include="$(PythonRuntimeCacheDir)x86\**\*" Exclude="$(PythonRuntimeCacheDir)x86\.complete" />
    </ItemGroup>
    <Copy SourceFiles="@(_PythonRuntimeFilesX86)" DestinationFolder="$(TargetDir)resources\python\x86\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Called once per architecture (via the MSBuild task, so $(PythonRuntimeArchDir) is a fresh
       global property each time, not shared/clobbered state) right after extraction. Enables
       site-packages in the embeddable package's ._pth, bootstraps pip, and installs
       @(PythonRuntimePackage). Non-fatal: a network hiccup here must not break the editor build. -->
  <Target Name="_EnablePythonRuntimeSitePackages">
    <ItemGroup>
      <_PythonPthLines Include="python$(PythonRuntimeMajorMinor).zip" />
      <_PythonPthLines Include="." />
      <_PythonPthLines Include="Lib\site-packages" />
      <_PythonPthLines Include="import site" />
    </ItemGroup>
    <MakeDir Directories="$(PythonRuntimeArchDir)Lib\site-packages" />
    <WriteLinesToFile File="$(PythonRuntimeArchDir)python$(PythonRuntimeMajorMinor)._pth" Lines="@(_PythonPthLines)" Overwrite="true" />
    <DownloadFile SourceUrl="https://bootstrap.pypa.io/get-pip.py" DestinationFolder="$(PythonRuntimeArchDir)" ContinueOnError="WarnAndContinue" />
    <Exec Command=".\python.exe get-pip.py --no-warn-script-location" WorkingDirectory="$(PythonRuntimeArchDir)" ContinueOnError="WarnAndContinue" Condition="Exists('$(PythonRuntimeArchDir)get-pip.py')" />
    <Exec Command=".\python.exe -m pip install --no-warn-script-location @(PythonRuntimePackage, ' ')" WorkingDirectory="$(PythonRuntimeArchDir)" ContinueOnError="WarnAndContinue" Condition="Exists('$(PythonRuntimeArchDir)Lib\site-packages\pip')" />
  </Target>
</Project>
