<Project>
  <!--
    Stages a self-contained CPython "embeddable package" next to a project's build output
    for the pythonnet-based scripting engine (PythonTool). pythonnet needs a real CPython
    DLL at runtime; it doesn't bundle one. Downloads once into a shared, gitignored cache
    under artifacts/, then copies from that cache into $(TargetDir)resources\python\<arch>\
    on every build, so a clean checkout just works with `dotnet build` (first build needs
    network access to fetch the embeddable package; later builds use the cache).

    A project opts in by setting <BundlePythonRuntimeX64>true</BundlePythonRuntimeX64> and/or
    <BundlePythonRuntimeX86>true</BundlePythonRuntimeX86> in its own .csproj.
  -->
  <PropertyGroup>
    <PythonRuntimeVersion>3.12.8</PythonRuntimeVersion>
    <PythonRuntimeCacheDir>$(SolutionDir)artifacts\PythonRuntime\$(PythonRuntimeVersion)\</PythonRuntimeCacheDir>
  </PropertyGroup>

  <Target Name="StagePythonRuntimeX64" AfterTargets="Build" Condition="'$(BundlePythonRuntimeX64)' == 'true'">
    <DownloadFile
      Condition="!Exists('$(PythonRuntimeCacheDir)x64\.complete')"
      SourceUrl="https://www.python.org/ftp/python/$(PythonRuntimeVersion)/python-$(PythonRuntimeVersion)-embed-amd64.zip"
      DestinationFolder="$(PythonRuntimeCacheDir)"
      DestinationFileName="python-embed-amd64.zip" />
    <Unzip
      Condition="!Exists('$(PythonRuntimeCacheDir)x64\.complete')"
      SourceFiles="$(PythonRuntimeCacheDir)python-embed-amd64.zip"
      DestinationFolder="$(PythonRuntimeCacheDir)x64\" />
    <Touch
      Condition="!Exists('$(PythonRuntimeCacheDir)x64\.complete')"
      Files="$(PythonRuntimeCacheDir)x64\.complete"
      AlwaysCreate="true" />
    <ItemGroup>
      <_PythonRuntimeFilesX64 Include="$(PythonRuntimeCacheDir)x64\**\*" Exclude="$(PythonRuntimeCacheDir)x64\.complete" />
    </ItemGroup>
    <Copy SourceFiles="@(_PythonRuntimeFilesX64)" DestinationFolder="$(TargetDir)resources\python\x64\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StagePythonRuntimeX86" AfterTargets="Build" Condition="'$(BundlePythonRuntimeX86)' == 'true'">
    <DownloadFile
      Condition="!Exists('$(PythonRuntimeCacheDir)x86\.complete')"
      SourceUrl="https://www.python.org/ftp/python/$(PythonRuntimeVersion)/python-$(PythonRuntimeVersion)-embed-win32.zip"
      DestinationFolder="$(PythonRuntimeCacheDir)"
      DestinationFileName="python-embed-win32.zip" />
    <Unzip
      Condition="!Exists('$(PythonRuntimeCacheDir)x86\.complete')"
      SourceFiles="$(PythonRuntimeCacheDir)python-embed-win32.zip"
      DestinationFolder="$(PythonRuntimeCacheDir)x86\" />
    <Touch
      Condition="!Exists('$(PythonRuntimeCacheDir)x86\.complete')"
      Files="$(PythonRuntimeCacheDir)x86\.complete"
      AlwaysCreate="true" />
    <ItemGroup>
      <_PythonRuntimeFilesX86 Include="$(PythonRuntimeCacheDir)x86\**\*" Exclude="$(PythonRuntimeCacheDir)x86\.complete" />
    </ItemGroup>
    <Copy SourceFiles="@(_PythonRuntimeFilesX86)" DestinationFolder="$(TargetDir)resources\python\x86\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
