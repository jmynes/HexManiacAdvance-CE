<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Stage the embeddable CPython runtime next to the exe so the headless Python engine
         (PythonTool) works in the MCP, exactly like HexManiac.Tests does. x64 only: the MCP
         is dev tooling. Staging logic lives in src/Directory.Build.targets (auto-imported). -->
    <BundlePythonRuntimeX64>true</BundlePythonRuntimeX64>
    <!-- net6.0 to match HexManiac.Core / the WPF editor, so the whole repo builds with one
         SDK (root global.json pins SDK 6) and the MCP can live in the solution. The MCP SDK
         and its transitive deps officially target net8+, so they resolve via netstandard2.0
         fallbacks here - verified to build and run, but unsupported by those packages.
         SuppressTfmSupportBuildWarnings silences the resulting "doesn't support net6.0" noise.
         Deliberate: one TFM (net6) across the app and the MCP for now. A future repo-wide
         move to net8 (LTS; net6 is EOL) is possible but should happen for the whole repo at
         once, when upstream moves - don't bump just the MCP back to net8. -->
    <TargetFramework>net6.0</TargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HexManiac.Mcp</AssemblyName>
    <RootNamespace>HavenSoft.HexManiac.Mcp</RootNamespace>
    <!-- Core emits many doc/style warnings; don't let them fail our build -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.75.0.4178" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexManiac.Core\HexManiac.Core.csproj" />
  </ItemGroup>

  <!-- Embed the MCP user guide so the help tool can serve it at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\MCP.md" Link="MCP.md" LogicalName="HexManiac.Mcp.MCP.md" />
  </ItemGroup>

  <!-- HexManiac.Core's Singletons loads reference files (scriptReference.txt, hma.py,
       *.toml, etc.) from a "resources/" folder relative to the working directory.
       Ship that folder next to the exe so the headless server can find it. -->
  <ItemGroup>
    <Content Include="resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
